
public class StringUtil {
	public static void main(String[] args) {

		/*

		Գրել method,  որը  կատարում է String
		concatenation  տվյալ պարամետրով․
		1.1     “hello” , “world”
		1.2     1 , 2 , “hello”
		1.3     “1” , 2 , “hello”
		1.4     “hello”, 1 ,2, “world”

		 */


		System.out.println("hello" + "world");
		System.out.println(1 + 2 +"hello");
		System.out.println("1" + 2 + "hello");
		System.out.println("hello" + 1 + 2 + "world");
		rep("We are living in");
		rev("sample");
		System.out.println(countSubString("We are living in an yellow submarine. We don't have anything", "in"));
		System.out.println(upper("hello world"));
		System.out.println(upper(new StringBuilder("hello world")));
		System.out.println(fill("Armenia"));
		String text = "We are living in an yellow submarine. We don't have anything";
		System.out.println(rem(text));
		System.out.println(removeA(new StringBuilder(text)));
		System.out.println(repst(text));
		System.out.println(longestWord(text));
		System.out.println("index " + findIndex(text, "a"));
		printSubLine("Hello World", 4);
		printSubLine(new StringBuilder("Hello World"), 4);
		System.out.println(checkString("Hello"));
		System.out.println(longestPart("We, are, living, in an, yellow, submarine, We don't, have anything"));



	}

	/*

	Գրել method,  որը  ստանում է String պարամետր և
	տպում է ամեն դատարկ  սիվոլից նոր տողում օգտագործելով
	String Literal ( \t, \b ….)․

	*/
	public static void rep(String line) {
		System.out.println(line.replace(" ", "\n"));
	}
	/*

	Գրել method (reverse), որը  շուռ է տալիս String.

	 */
	public static void rev(String x) {
		StringBuilder result = new StringBuilder(x);
		System.out.println(result.reverse());
	}

	/*

	 Գրել method, որը ստուգում է թե քանի անգամ է տրված տեքստում հանդիպել token ենթատողը.

	 */
	public static int countSubString(String line, String token) {
		int count = 0;

		while(line.contains(token)) {
			count++;

			line = line.substring(line.indexOf(token) + token.length());
		}
		return count;
	}

	/*

	Գրել method, որը  տեքստը սարքում է մեծատառերով գրված, օգտագործելով String.
	Նույնը  խնդիրը   StringBuilder-ով.

	 */

	public static String upper(String line) {
		return line.toUpperCase();
	}

	public static StringBuilder upper(StringBuilder line) {
		return new StringBuilder(line.toString().toUpperCase());
	}

	/*

	Գրել method, որը console-ից կարդում է 20
	երկարությամբ սիմվոլների տող , տպում այն եթե տողի
	երկարությունը պակաս է 20 ից ապա պետք է տողը
	լռացնենք պակաս սիմվոլների փոխարեն գրելով «*» սիմվոլը.

	 */
	public static String fill(String line) {
		for(int i = line.length(); i < 20; i++) {
			line += "*";
		}
		return line;
	}

	/*

	Գրել method, որը տրված տեքստից հեռացնում է բոլոր « a »  սիմվոլները.
	 Նույնը խնդիրը  StringBuilder-ով.

	 */
	public static String rem(String line) {
		return line.replace("a", " ");
	}


	public static StringBuilder removeA(StringBuilder line) {

		for (int i = line.length() - 1; i >= 0; i--) {

			if (line.charAt(i) == 'a') {
				line.deleteCharAt(i);
			}
		}

		return line;
	}
	/*

	 Գրել method, որը տրված տեքստում բոլոր « a »
	 սիմվոլները փոխարինում է « * » , օգտագործելով String.


	 */
	public static String repst(String line) {
		return line.replace("a", "*");
	}

	/*

	Գրել method, որը գտնում է տեքստում ամենաերկար բառը,
	տեքստում բառերը անջատված են իրարից պռոբելով.

	 */
	public static String longestWord(String line) {

		String[] words = line.split(" ");
		String longest = "";

		for (int i = 0; i < words.length; i++) {

			if (words[i].length() > longest.length()) {

				longest = words[i];
			}
		}

		return longest;
	}
	/*

	Գրել method, որը գտնում է թե, որերորդ ինդեքսում է
	առաջին անգամ հանդիպել String c  սիմվոլը

	 */
	public static int findIndex(String line, String c) {

		return line.indexOf(c);
	}
	/*

	Գրել method, որը գտնում և տպում է տրված տողի սկզբից մինչև n-րդ ինդեքսը պարունակող ենթատողը, օգտագործելով String.
	Նույնը խնդիրը StringBuilder-ով.

	 */
	public static void printSubLine(String line, int n) {

		System.out.println(line.substring(0, n + 1));
	}

	public static void printSubLine(StringBuilder line, int n) {

		System.out.println(line.substring(0, n + 1));
	}
	/*

	 Գրել method, որը ստուգում է թե արդյոք  տրված
	 String պարամետրը  դատարկ և null չէ․

	 */
	public static boolean checkString(String line) {

		return line != null && !line.isEmpty();
	}
	/*

	Գրել method, որը տրոհում է նախադսությունը
	ըստ  ‘,’   և գտում ամեներկար բառը ․

	 */

	public static String longestPart(String line) {

		String longest = "";
		int start = 0;

		for (int i = 0; i <= line.length(); i++) {

			if (i == line.length() || line.charAt(i) == ',') {

				String word = line.substring(start, i).trim();

				if (word.length() > longest.length()) {
					longest = word;
				}

				start = i + 1;
			}
		}

		return longest;
	}

